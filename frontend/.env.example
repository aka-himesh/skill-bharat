# Base URL for the backend API. Leave empty to use mock data only.
VITE_API_URL=http://localhost:8000

# Set to "true" to use built-in mock data (no backend required)
VITE_USE_MOCK=true

# Fallback branding (used if /api/config is unreachable)
VITE_APP_NAME=AI-LMIS
VITE_APP_SHORT_NAME=AI-LMIS
VITE_APP_TAGLINE=Labour Market Intelligence & Skill Demand-Supply Forecasting Engine
