APP_NAME=AI-LMIS
APP_SHORT_NAME=AI-LMIS
APP_TAGLINE=AI-Enabled Labour Market Intelligence System
DB_PATH=backend/data/lmis.db
BACKEND_PORT=8000
FRONTEND_PORT=5173
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_PIN=26246
ACCESS_PASSWORD=zeroone
# Connector credentials (do not commit real keys)
NCS_API_KEY=
ESHRAM_API_KEY=
MOSPI_API_KEY=

# ── Live Data Sources ─────────────────────────────────────────────────────────
# Set USE_LIVE_DATA=false for fully offline / demo mode (synthetic data only)
USE_LIVE_DATA=true

# data.gov.in e-Shram integration
DATAGOV_API_KEY=
# Resource ID for "District-wise Demographic Data of Unorganised Workers registered on eShram as on Previous Day"
# Find it at https://data.gov.in → Datasets → search "eShram district demographic"
ESHRAM_RESOURCE_ID=1d4d1c5a-feea-423b-be4f-xxxxxxxxxx
DATAGOV_BASE_URL=https://api.data.gov.in/resource
# Dataset is updated daily ("as on previous day"), 24-hour cache is appropriate
ESHRAM_CACHE_TTL_HOURS=24

# News provider: newsapi | gnews | rss (rss requires no key; falls back automatically)
NEWS_PROVIDER=rss
NEWS_API_KEY=
NEWS_CACHE_TTL_MINUTES=30
NEWS_MAX_ITEMS=12
# Minimum relevance score to include a news item (title match x3 + desc match x1)
NEWS_MIN_SCORE=1
