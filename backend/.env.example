# Copy to backend/.env. Never commit credentials. Values are optional until access is granted.

# MoSPI e-Sankhyiki: PLFS open API works without a key.
MOSPI_API_BASE_URL=https://api.mospi.gov.in
MOSPI_API_KEY=

# NCS: configure only after DGE approval. Use the exact approved endpoint URL.
NCS_API_BASE_URL=
NCS_API_KEY=

# data.gov.in: request a free key at https://data.gov.in/user/register.
DATA_GOV_IN_API_KEY=

# Existing e-Shram resource integration. Keep blank until a real resource ID is selected.
ESHRAM_RESOURCE_ID=
DATAGOV_BASE_URL=https://api.data.gov.in/resource

# Shared external API resilience settings.
EXTERNAL_CACHE_TTL_HOURS=24
EXTERNAL_REQUEST_TIMEOUT_MS=10000
EXTERNAL_MAX_RETRIES=2
